{
  "name": "@sigmx/hono",
  "version": "0.2.0",
  "description": "Hono middleware for sigmx: read signals from the request, answer with HTML, JSON or a stream of patches, serve the client.",
  "keywords": [
    "hono",
    "hono-middleware",
    "sigmx",
    "hypermedia",
    "sse"
  ],
  "author": "Callum Bonnyman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrux/sigmx.git",
    "directory": "sdks/hono"
  },
  "homepage": "https://github.com/wrux/sigmx#readme",
  "bugs": {
    "url": "https://github.com/wrux/sigmx/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "hono": "^4.13.7",
    "sigmx": "file:../..",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "hono": ">=4.6.0",
    "sigmx": "^0.2.0"
  }
}
