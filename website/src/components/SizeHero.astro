---
import compare from '../data/compare.json';
import sizes from '../data/sizes.json';

const kb = (n: number) => (n / 1024).toFixed(1);
function must<T>(v: T | undefined, what: string): T {
  if (v === undefined) throw new Error(`sizes data is missing ${what}`);
  return v;
}
const find = (prefix: string) =>
  must(
    sizes.bundles.find((b: any) => b.name.startsWith(prefix)),
    prefix,
  );
const tiers = [
  { label: 'core', sub: 'signals, store, expressions, the engine', size: find('core only').brotli },
  { label: 'essentials', sub: 'state, rendering, forms, requests, morph', size: find('essentials preset').brotli },
  {
    label: 'everything',
    sub: `all ${sizes.perPlugin.length} plugins, shipped file`,
    size: find('everything, shipped').brotli,
  },
];
const bars = [
  ...tiers.map((t) => ({ name: `sigmx ${t.label}`, size: t.size, mine: true })),
  ...compare.libraries.map((l: any) => ({ name: `${l.name} ${l.version}`, size: l.brotli, mine: false, note: l.note })),
];
const max = Math.max(...bars.map((b) => b.size));
const lib = (n: string) =>
  must(
    compare.libraries.find((l: any) => l.name === n),
    n,
  );
const pct = (a: number, b: number) => Math.round((1 - a / b) * 100);
const everything = tiers[2].size;
const vsHtmx = pct(everything, lib('htmx').brotli);
const vsDatastar = pct(everything, lib('Datastar').brotli);
const datastarLine =
  vsDatastar >= 2
    ? `${vsDatastar}% smaller than Datastar`
    : vsDatastar <= -2
      ? `${-vsDatastar}% larger than Datastar`
      : `within 2% of Datastar`;
---
<section class="hero-sizes not-content">
  <div class="tiers">
    {tiers.map((t) => (
      <div class="tier">
        <b>{kb(t.size)}<small>KB</small></b>
        <span class="label">{t.label}</span>
        <span class="sub">{t.sub}</span>
      </div>
    ))}
  </div>
  <p class="how">Brotli-compressed, the way a CDN serves it. Register only what you use and the runtime is whatever those plugins weigh. Everything, all {sizes.perPlugin.length} plugins including the Alpine and htmx extensions, is {vsHtmx}% smaller than htmx alone and {datastarLine} (23 plugins).</p>
  <div class="bars">
    {bars.map((b) => (
      <div class={`bar ${b.mine ? 'mine' : ''}`}>
        <span class="name">{b.name}</span>
        <span class="track"><i style={`width:${(b.size / max) * 100}%`}></i></span>
        <span class="size">{kb(b.size)} KB</span>
      </div>
    ))}
  </div>
  <p class="foot">
    Measured {compare.measuredAt}: {compare.libraries.map((l: any) => `${l.name} (${l.note})`).join(', ')}. Every number comes from
    <code>npm run size</code> and <code>npm run compare</code>, brotli quality 11.
  </p>
</section>
<style>
  .hero-sizes { display: grid; gap: 1.2rem; margin: 2rem auto 0; max-width: 56rem; }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--sl-color-hairline); border: 1px solid var(--sl-color-hairline); border-radius: 14px; overflow: hidden; }
  @media (max-width: 40rem) { .tiers { grid-template-columns: 1fr; } }
  .tier { background: var(--sl-color-bg); padding: 1.2rem 1.3rem; display: grid; gap: .15rem; }
  .tier b { font-size: 2.6rem; line-height: 1; letter-spacing: -.03em; color: var(--sl-color-accent-high); font-variant-numeric: tabular-nums; }
  .tier b small { font-size: 1rem; margin-left: .25rem; color: var(--sl-color-gray-3); letter-spacing: 0; font-weight: 500; }
  .tier .label { font-weight: 600; text-transform: uppercase; letter-spacing: .08em; font-size: .78rem; }
  .tier .sub { color: var(--sl-color-gray-3); font-size: .85rem; }
  .how, .foot { margin: 0; color: var(--sl-color-gray-3); font-size: .9rem; text-align: center; }
  .foot { font-size: .78rem; }
  .bars { display: grid; gap: .45rem; padding: 1rem 1.2rem; border: 1px solid var(--sl-color-hairline); border-radius: 14px; background: var(--sl-color-bg); }
  .bar { display: grid; grid-template-columns: 11rem 1fr 5rem; gap: .8rem; align-items: center; font-size: .88rem; }
  .bar .name { color: var(--sl-color-gray-2); text-align: right; }
  .bar .track { height: .7rem; border-radius: 999px; background: var(--sl-color-gray-6); overflow: hidden; }
  .bar .track i { display: block; height: 100%; border-radius: 999px; background: var(--sl-color-gray-4); }
  .bar.mine .track i { background: linear-gradient(90deg, var(--sl-color-accent), #7c5cff); }
  .bar.mine .name { color: var(--sl-color-white); font-weight: 600; }
  .bar .size { font-variant-numeric: tabular-nums; text-align: right; }
  @media (max-width: 40rem) { .bar { grid-template-columns: 1fr; gap: .2rem; } .bar .name, .bar .size { text-align: left; } }
</style>
