<div class="ex contact" data-signals="{ sent: false }">
  <form data-on:submit="@post('/api/form', { contentType: 'form' })" data-show="!$sent" data-indicator:sending>
    <div class="grid">
      <label>Email <input class="field" name="email" type="email" placeholder="you@example.com"></label>
      <label>Message <input class="field" name="message" placeholder="At least five characters"></label>
    </div>
    <div id="form-status"></div>
    <div class="actions"><span class="muted small">Validated on the server; errors come back as a patch.</span><button class="btn" data-attr:disabled="$sending">Send</button></div>
  </form>
  <div class="thanks" data-show="$sent" style="display:none">
    <span class="big" aria-hidden="true">✓</span>
    <p>Sent. <button class="btn ghost" type="button" data-on:click="$sent = false">Send another</button></p>
  </div>
</div>
<style is:global>
  .contact { padding: 1rem; background: var(--ex-surface); }
  .contact .grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  @media (max-width: 40rem) { .contact .grid { grid-template-columns: 1fr; } }
  .contact label { display: grid; gap: .25rem; font-size: .85rem; }
  .contact #form-status { margin: .6rem 0; }
  .contact #form-status ul { margin: 0; padding: .6rem .9rem .6rem 1.8rem; border-radius: 10px; background: color-mix(in srgb, var(--ex-bad) 12%, transparent); color: var(--ex-bad); font-size: .85rem; }
  .contact .actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .contact .small { font-size: .78rem; }
  .contact .thanks { display: grid; justify-items: center; gap: .3rem; padding: .5rem; text-align: center; }
  .contact .big { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: color-mix(in srgb, var(--ex-good) 16%, transparent); color: var(--ex-good); font-size: 1.5rem; }
  .contact .thanks p { margin: 0; display: flex; align-items: center; gap: .6rem; }
</style>
