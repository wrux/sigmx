<div class="ex custom" data-signals="{ text: 'registered with instance.use()' }">
  <span class="label">data-upper</span>
  <p data-upper="$text">this text is replaced once the plugin registers</p>
  <input class="field" data-bind:text placeholder="Type something">
</div>
<script>
  import { attribute } from 'sigmx'
  const upper = attribute({
    name: 'upper',
    value: 'required',
    mount({ el, evaluate, effect }) {
      effect(() => { el.textContent = String(evaluate()).toUpperCase() })
    },
  })
  ;(window as any).sigmx.use(upper)
</script>
<style is:global>
  .custom { padding: 1rem; display: grid; gap: .5rem; background: var(--ex-surface); }
  .custom .label { font-family: var(--sl-font-mono); font-size: .72rem; color: var(--ex-muted); }
  .custom p { margin: 0; font-weight: 600; letter-spacing: .04em; }
</style>
