---
import ToolHandler from './chat/ToolHandler.astro'
---
<div class="ex chat" data-signals="{ draft: '', thinking: false, turn: 0, words: 0, chatId: '' }" data-init="$chatId = crypto.randomUUID()" data-persist:chat-draft="{ include: /^draft$/ }">
  <header class="bar">
    <span class="avatar big" aria-hidden="true">σ</span>
    <div><b>sigmx agent</b><small class="muted"><span class="pulse"></span> <span data-text="$thinking ? 'typing…' : 'online · canned replies, real plumbing'"></span></small></div>
    <span class="chip" data-show="$words" data-text="$words + ' words'"></span>
  </header>
  <ul id="chat-log" class="log">
    <li class="msg assistant"><span class="avatar" aria-hidden="true">σ</span><div class="bubble"><p>Hi! Ask me anything. Try <em>what time is it</em>, <em>weather</em>, or <em>how does this work</em>.</p></div></li>
  </ul>
  <div class="typing" data-show="$thinking" style="display:none"><span></span><span></span><span></span></div>
  <form class="composer" data-on:submit="@post('/api/chat')" data-indicator:sending>
    <textarea class="field" data-bind:draft rows="1" placeholder="Message… (Enter to send, Shift+Enter for a new line)" required
      data-on:keydown="evt.key === 'Enter' && !evt.shiftKey && (evt.preventDefault(), el.form.requestSubmit())"></textarea>
    <button class="btn round" title="Send" data-attr:disabled="$thinking || !$draft.trim()" data-show="!$thinking">↑</button>
    <button class="btn round stop" type="button" title="Stop" data-show="$thinking" style="display:none" data-on:click="@post('/api/chat/stop')">■</button>
  </form>
  <p class="hint muted" data-show="$draft.length > 0" data-text="$draft.length + ' characters · draft saved locally'"></p>
</div>
<ToolHandler />
<style is:global>
  .chat { display: grid; grid-template-rows: auto 1fr auto auto auto; height: 30rem; background: var(--ex-surface); }
  .chat .bar { display: flex; align-items: center; gap: .7rem; padding: .7rem 1rem; border-bottom: 1px solid var(--ex-line); }
  .chat .bar b { display: block; font-size: .95rem; }
  .chat .bar small { display: flex; align-items: center; gap: .4rem; font-size: .75rem; }
  .chat .bar .chip { margin-left: auto; }
  .chat .avatar { display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: linear-gradient(135deg, var(--ex-accent), #7c5cff); color: #fff; font-weight: 700; font-family: var(--sl-font-mono); flex: none; }
  .chat .avatar.big { width: 2.4rem; height: 2.4rem; font-size: 1.1rem; }
  .chat .log { list-style: none; margin: 0; padding: 1rem; overflow: auto; display: grid; gap: .7rem; align-content: start; background: radial-gradient(circle at 100% 0, var(--ex-accent-low), transparent 45%); }
  .chat .msg { display: flex; gap: .5rem; align-items: flex-end; max-width: 82%; animation: msg-in .25s ease-out; }
  @keyframes msg-in { from { opacity: 0; transform: translateY(6px) } }
  .chat .msg.user { margin-left: auto; flex-direction: row-reverse; }
  .chat .bubble { position: relative; padding: .55rem .8rem .35rem; border-radius: 16px; background: var(--ex-surface-2); border: 1px solid var(--ex-line); }
  .chat .msg.assistant .bubble { border-bottom-left-radius: 4px; }
  .chat .msg.user .bubble { border-bottom-right-radius: 4px; background: var(--ex-accent); border-color: transparent; color: #fff; }
  :root[data-theme='dark'] .chat .msg.user .bubble { color: var(--sl-color-black); }
  .chat .bubble p { margin: 0; line-height: 1.45; }
  .chat .bubble time { display: block; font-size: .65rem; opacity: .6; text-align: right; margin-top: .2rem; font-variant-numeric: tabular-nums; }
  .chat .msg.tool { max-width: 90%; }
  .chat .msg.tool .bubble { background: transparent; border: 1px dashed var(--ex-accent); font-family: var(--sl-font-mono); font-size: .82rem; }
  .chat .tool-icon { font-size: 1.2rem; }
  .chat .who { display: block; font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ex-muted); }
  .chat .typing { display: flex; gap: .3rem; padding: 0 1rem .4rem; }
  .chat .typing span { width: .5rem; height: .5rem; border-radius: 50%; background: var(--ex-muted); animation: bounce 1s infinite; }
  .chat .typing span:nth-child(2) { animation-delay: .15s } .chat .typing span:nth-child(3) { animation-delay: .3s }
  @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); opacity: .5 } 30% { transform: translateY(-.35rem); opacity: 1 } }
  .chat .composer { display: flex; gap: .5rem; align-items: flex-end; padding: .6rem 1rem 0; border-top: 1px solid var(--ex-line); }
  .chat .composer textarea { resize: none; border-radius: 18px; min-height: 2.5rem; }
  .chat .btn.stop { background: var(--ex-bad); color: #fff; }
  .chat .hint { margin: .3rem 1rem .6rem; font-size: .75rem; min-height: 1em; }
</style>
