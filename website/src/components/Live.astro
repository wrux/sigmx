---
import { Code } from '@astrojs/starlight/components';

interface Props {
  html: string;
  title?: string;
  code?: boolean;
}
const { html, title = 'Live', code = true } = Astro.props;

// MDX strips the indentation from multi-line template literals passed as props, so the source arrives
// flattened. Rebuild it from the tag structure: one level per element still open at the end of a line.
const VOID = new Set(['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr']);
const indent = (source: string) => {
  let depth = 0;
  return source
    .trim()
    .split('\n')
    .map((raw) => {
      const line = raw.trim();
      if (!line) return '';
      const counted = line.replace(/<!--[\s\S]*?-->/g, '');
      if (/^<\//.test(counted)) depth = Math.max(0, depth - 1);
      const out = '  '.repeat(depth) + line;
      let net = /^<\//.test(counted) ? 1 : 0;
      for (const m of counted.matchAll(/<(\/?)([a-zA-Z][\w-]*)[^>]*?(\/?)>/g)) {
        if (m[1]) net -= 1;
        else if (!m[3] && !VOID.has(m[2].toLowerCase())) net += 1;
      }
      depth = Math.max(0, depth + net);
      return out;
    })
    .join('\n');
};
const src = indent(html);
---
<div class="live not-content">
  <div class="live-label">{title}</div>
  <div class="live-body" set:html={src} />
</div>
{code && <Code code={src} lang="html" />}
