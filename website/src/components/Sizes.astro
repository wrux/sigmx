---
import sizes from '../data/sizes.json'
interface Props { plugins?: boolean }
const { plugins = false } = Astro.props
const kb = (n: number) => (n / 1024).toFixed(1) + ' KB'
const rows = plugins ? [...sizes.perPlugin].sort((a, b) => b.gzip - a.gzip) : sizes.bundles
---
<div class="sizes">
<table>
  <thead><tr><th>{plugins ? 'plugin (added on top of the core)' : 'what you register'}</th><th>minified</th><th>gzip</th><th>brotli</th></tr></thead>
  <tbody>
    {rows.map((r: any) => (
      <tr class={r.name?.startsWith('everything') || r.name?.startsWith('minimal preset') ? 'hl' : ''}>
        <td>{r.name}</td><td class="num">{plugins ? r.raw + ' B' : kb(r.raw)}</td><td class="num">{plugins ? r.gzip + ' B' : kb(r.gzip)}</td><td class="num">{plugins ? r.brotli + ' B' : kb(r.brotli)}</td>
      </tr>
    ))}
  </tbody>
</table>
<p class="muted">Measured {sizes.measuredAt} with esbuild (minify, mangle internals), gzip level 9 and brotli quality 11. Regenerate with <code>npm run sizes</code>.</p>
</div>
