{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev.mjs"],
      "port": 8765
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev", "--", "--port", "4321", "--host", "127.0.0.1"],
      "port": 4321
    },
    {
      "name": "vite-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/vite", "run", "dev", "--", "--port", "5173", "--host", "127.0.0.1"],
      "port": 5173
    },
    {
      "name": "astro-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/astro", "run", "dev", "--", "--port", "4322", "--host", "127.0.0.1"],
      "port": 4322
    },
    {
      "name": "express-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/express", "run", "dev"],
      "port": 3000
    },
    {
      "name": "hono-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/hono", "run", "dev"],
      "port": 3001
    },
    {
      "name": "rust-axum-example",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--manifest-path",
        "sdks/rust/Cargo.toml",
        "-p",
        "sigmx",
        "--example",
        "axum",
        "--features",
        "axum,client"
      ],
      "port": 3000
    }
  ]
}
